# Local development against the demo database (`npm run demo:db`).
# Copy to .env.local, which is gitignored.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=kanbai-demo
DB_NAME=kanbai

# Tracker, read-only. In production: a Personal Access Token scoped to Work
# Items (Read). Locally, leave ADO_PAT unset and run `npm run ado:snapshot`,
# which writes demo/tracker.json from your Azure CLI login; ADO_FIXTURE makes
# the app read that file instead of the API.
ADO_ORG=paulburkart1
ADO_PROJECT=Orchestrata
# ADO_PAT=
ADO_FIXTURE=demo/tracker.json

# Sign-in for /manage. Generate your own with `npm run hash-password`; the hash
# below is for the demo password "kanbai-demo-admin" and is only fit for a
# database with nothing real in it.
ADMIN_USERNAME=demo
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:JUMiXOvXMY7u3CeCPdoXOA:yU9CGZT4n2yao9frrx42YMVvzlK7gFTwdOJ_4HPsTPaW5u8ys4NlKgKpajg1_qo2lvkSXDkj-AaOIT2iFIwSVQ
